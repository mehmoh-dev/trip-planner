---
import Layout from '../layouts/Layout.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'Wander';
---

<Layout title="Thoughtful trips, planned in minutes" active="home">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Your itinerary, minus the spreadsheet</p>
        <h1>Plan a trip you'll actually want to take.</h1>
        <p class="hero__lead">
          Tell us where you're headed and what you love. In seconds you'll get a day-by-day
          plan built around the places travelers rate most, a realistic price, and where to
          book — then a friendly email whenever a new trip is worth your time.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary btn--lg" href="#plan">Start planning</a>
          <a class="btn btn--outline btn--lg" href="#trips">Browse trips</a>
        </div>
        <div class="hero__trust">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span>Recommendations tuned for great places, good value, and comfortable days.</span>
        </div>
      </div>

      <aside class="hero__card" aria-hidden="true">
        <div class="ticket">
          <div class="ticket__top">
            <div>
              <span class="ticket__eyebrow">Recommended plan</span>
              <h3>4 days in Lisbon</h3>
            </div>
            <div class="ticket__price">€960<small>/person</small></div>
          </div>
          <ul class="ticket__days">
            <li><span>01</span> Alfama lanes &amp; a sunset miradouro</li>
            <li><span>02</span> Belém pastries &amp; a riverside ride</li>
            <li><span>03</span> Day trip to Sintra's palaces</li>
            <li><span>04</span> Time Out Market &amp; farewell fado</li>
          </ul>
          <div class="ticket__foot">
            <span class="tag">Popular</span><span class="tag">Great value</span><span class="tag">Relaxed</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="section--tight">
    <div class="wrap">
      <div class="stats" id="stats">
        <div class="stat"><b data-stat="trips">0</b><span>Curated trips</span></div>
        <div class="stat"><b data-stat="destinations">0</b><span>Destinations</span></div>
        <div class="stat"><b data-stat="subscribers">0</b><span>Subscribers</span></div>
        <div class="stat"><b data-stat="views">0</b><span>Itineraries explored</span></div>
      </div>
    </div>
  </section>

  <!-- ============ PLANNER ============ -->
  <section class="section" id="plan">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Build your itinerary</p>
        <h2>Where would you like to go?</h2>
        <p>Add a few details. Plans are built around the spots travelers love most — balancing value and comfort.</p>
      </div>

      <div class="card">
        <form id="planner-form">
          <div class="grid grid-2">
            <div class="field">
              <label for="destination">Destination</label>
              <input id="destination" name="destination" placeholder="e.g. Kyoto, Japan" required />
            </div>
            <div class="field">
              <label for="interests">What are you into?</label>
              <input id="interests" name="interests" placeholder="food, temples, slow mornings" />
            </div>
          </div>
          <div class="grid grid-3">
            <div class="field"><label for="startDate">Start date</label><input id="startDate" name="startDate" type="date" /></div>
            <div class="field"><label for="endDate">End date</label><input id="endDate" name="endDate" type="date" /></div>
            <div class="field"><label for="travelers">Travelers</label><input id="travelers" name="travelers" type="number" min="1" value="2" /></div>
          </div>
          <div class="grid grid-3">
            <div class="field"><label for="budget">Budget / person (optional)</label><input id="budget" name="budget" type="number" min="0" placeholder="e.g. 1200" /></div>
            <div class="field"><label for="currency">Currency</label>
              <select id="currency" name="currency"><option>USD</option><option>EUR</option><option>GBP</option><option>PKR</option><option>INR</option><option>AED</option><option>JPY</option></select>
            </div>
            <div class="field"><label for="pace">Pace</label>
              <select id="pace" name="pace"><option value="relaxed">Relaxed</option><option value="balanced" selected>Balanced</option><option value="packed">Packed</option></select>
            </div>
          </div>
          <button class="btn btn--primary btn--lg" type="submit" id="generate-btn">Build my itinerary</button>
          <div id="planner-note" class="note hidden"></div>
        </form>

        <div id="itinerary-result" class="result hidden"></div>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section section--sand">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">How it works</p>
        <h2>Three steps, no overwhelm</h2>
      </div>
      <div class="steps">
        <div class="step"><div class="step__num">01</div><h3>Tell us the basics</h3><p>Destination, dates, and the things that make a trip feel like yours.</p></div>
        <div class="step"><div class="step__num">02</div><h3>Get a real plan</h3><p>A day-by-day itinerary built from popular, well-loved spots — with an honest price.</p></div>
        <div class="step"><div class="step__num">03</div><h3>Stay in the loop</h3><p>Subscribe and we'll email you when a new trip is worth a look.</p></div>
      </div>
    </div>
  </section>

  <!-- ============ TRIPS TRAVELERS LOVE ============ -->
  <section class="section" id="trips">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Trips travelers love</p>
          <h2>Ready-made plans to steal</h2>
          <p style="max-width:520px;">Ranked by where people are actually heading — popular, good value, and comfortable. Tap one to explore.</p>
        </div>
      </div>
      <div id="trips-note" class="note info hidden"></div>
      <div id="trips" class="trip-grid"></div>
    </div>
  </section>

  <!-- ============ RECENTLY EXPLORED ============ -->
  <section class="section section--sand" id="recent">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Last visited</p>
        <h2>Recently explored</h2>
        <p>Destinations travelers have been looking at lately. Tap to plan your own version.</p>
      </div>
      <div id="recent-list" class="recent-grid"></div>
    </div>
  </section>

  <!-- ============ WHY US ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Why {siteName}</p>
        <h2>Planning that respects your time</h2>
      </div>
      <div class="features">
        <div class="feature">
          <div class="feature__icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="11" r="2.4" stroke="currentColor" stroke-width="1.6"/></svg></div>
          <h3>Where people actually go</h3>
          <p>Plans favor the popular, well-reviewed places travelers search for and rate highly.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M12 3v18M7 7h7a3 3 0 0 1 0 6H8a3 3 0 0 0 0 6h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></div>
          <h3>Honest, good value</h3>
          <p>A realistic per-person estimate up front, leaning toward cost-effective choices.</p>
        </div>
        <div class="feature">
          <div class="feature__icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.6"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></div>
          <h3>Comfortable &amp; calm</h3>
          <p>Sensible pacing, and helpful nudges by email — never a packed schedule or noise.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section section--sand">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">In their words</p>
        <h2>Travelers who stopped overthinking</h2>
      </div>
      <div id="testimonials" class="testimonials"></div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section" id="faq">
    <div class="wrap wrap--narrow">
      <div class="section-head center">
        <p class="eyebrow">Good to know</p>
        <h2>Questions, answered</h2>
      </div>
      <div class="faq">
        <details open><summary>Is it free to plan a trip?</summary><p>Yes. Building an itinerary and browsing trips is completely free.</p></details>
        <details><summary>How are the recommendations chosen?</summary><p>Plans lean toward the popular, well-loved places travelers commonly search for and rate highly, balanced for good value and a comfortable pace — not a packed checklist.</p></details>
        <details><summary>How accurate is the price estimate?</summary><p>It's a realistic per-person estimate covering accommodation, activities and local transport. International flights aren't included, since those vary a lot by origin.</p></details>
        <details><summary>What do I get when I subscribe?</summary><p>A short, friendly email whenever a new trip is published — never spam, and you can ignore any that don't fit.</p></details>
      </div>
    </div>
  </section>

  <!-- ============ SUBSCRIBE ============ -->
  <section class="section" id="subscribe">
    <div class="wrap">
      <div class="cta">
        <div class="cta__copy">
          <h2>Never miss a good trip</h2>
          <p>Drop your email and we'll let you know when a new itinerary is ready.</p>
        </div>
        <form id="subscribe-form" class="cta__form">
          <input id="sub-email" type="email" placeholder="you@example.com" required aria-label="Email address" />
          <button class="btn btn--dark btn--lg" type="submit" id="subscribe-btn">Subscribe</button>
        </form>
      </div>
      <div id="subscribe-note" class="note hidden" style="max-width:520px;margin:14px auto 0;"></div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 66px 0 34px; }
  .hero__inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 52px; align-items: center; }
  .hero h1 { font-size: clamp(40px, 5.6vw, 62px); line-height: 1.02; }
  .hero__lead { color: var(--ink-soft); font-size: 18px; margin-top: 22px; max-width: 31em; }
  .hero__cta { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .hero__trust { display: flex; align-items: center; gap: 12px; margin-top: 26px; font-size: 14px; color: var(--muted); }

  .hero__card { display: flex; justify-content: center; }
  .ticket { width: 100%; max-width: 390px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 26px; box-shadow: var(--shadow-lg); transform: rotate(-1.4deg); }
  .ticket__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .ticket__eyebrow { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--primary); }
  .ticket__top h3 { font-size: 25px; margin-top: 6px; }
  .ticket__price { font-family: var(--serif); font-size: 27px; color: var(--accent-600); white-space: nowrap; }
  .ticket__price small { font-family: var(--sans); font-size: 11px; color: var(--muted); }
  .ticket__days { list-style: none; margin: 22px 0 0; padding: 20px 0; border-top: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
  .ticket__days li { font-family: var(--sans); font-size: 14.5px; color: var(--ink-soft); display: flex; gap: 12px; padding: 7px 0; }
  .ticket__days span { font-family: var(--serif); color: var(--primary); font-weight: 600; }
  .ticket__foot { display: flex; gap: 8px; margin-top: 18px; }

  .section--sand { background: var(--sand-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .stat { text-align: center; padding: 24px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .stat b { display: block; font-family: var(--serif); font-size: 36px; color: var(--ink); font-weight: 600; }
  .stat span { font-size: 13.5px; color: var(--muted); }

  .result { margin-top: 26px; }
  .result__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 22px; margin: 22px 0 22px; flex-wrap: wrap; }
  .result__head h3 { font-size: 27px; }
  .result__head .muted { margin-top: 6px; max-width: 46em; }
  .result__price { text-align: right; }
  .result__price .muted { display: block; font-size: 12px; }
  #it-bookings { margin-top: 24px; }
  #it-bookings h4 { font-size: 17px; margin-bottom: 12px; }

  .cta { background: linear-gradient(120deg, var(--primary-700), var(--primary)); color: #fff; border-radius: 24px; padding: 44px; display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; box-shadow: var(--shadow-lg); }
  .cta h2 { color: #fff; font-size: 30px; }
  .cta p { color: #d6f2ee; margin-top: 8px; }
  .cta__form { display: flex; gap: 10px; flex: 1; min-width: 280px; max-width: 480px; }
  .cta__form input { border: 0; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; gap: 34px; }
    .hero__card { order: -1; }
    .stats { grid-template-columns: 1fr 1fr; }
    .result__head { flex-direction: column; }
    .result__price { text-align: left; }
    .cta { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const fmt = (n: number, c: string) => { try { return new Intl.NumberFormat('en-US', { style: 'currency', currency: c, maximumFractionDigits: 0 }).format(n); } catch { return `${c} ${Math.round(n)}`; } };
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  // Format a date-only value (YYYY-MM-DD or ISO) without timezone shifting.
  const fmtDate = (d?: string | null) => {
    if (!d) return '';
    const [y, m, day] = String(d).slice(0, 10).split('-').map(Number);
    if (!y || !m || !day) return '';
    return new Date(Date.UTC(y, m - 1, day)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
  };
  const fmtRange = (a?: string | null, b?: string | null) => {
    if (!a || !b) return 'Flexible dates';
    return `${fmtDate(a)} – ${fmtDate(b)}, ${String(b).slice(0, 4)}`;
  };
  const showNote = (el: HTMLElement, msg: string, kind: 'ok' | 'err' | 'info' = 'info') => { el.textContent = msg; el.className = `note ${kind}`; };
  const hide = (el: HTMLElement) => el.classList.add('hidden');

  const PALETTES = [
    ['#0d9488', '#0f766e'], ['#ef6a34', '#ff7a45'], ['#2a6f97', '#014f86'],
    ['#e09f3e', '#9e2a2b'], ['#3a5a40', '#588157'], ['#6a4c93', '#3d348b'],
    ['#118ab2', '#073b4c'], ['#d1495b', '#8d2f3f'],
  ];
  function hueIndex(seed: string) { let h = 0; for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) % 997; return h % PALETTES.length; }
  function cover(seed: string) { const [a, b] = PALETTES[hueIndex(seed)]; return `background:linear-gradient(135deg, ${a}, ${b});`; }
  function solid(seed: string) { return PALETTES[hueIndex(seed)][0]; }
  function timeAgo(iso: string) {
    const s = Math.max(1, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
    const u: [number, string][] = [[86400, 'd'], [3600, 'h'], [60, 'm']];
    for (const [secs, label] of u) if (s >= secs) return `${Math.floor(s / secs)}${label} ago`;
    return 'just now';
  }

  async function api(url: string, method = 'GET', body?: any) {
    const res = await fetch(url, { method, headers: body ? { 'Content-Type': 'application/json' } : undefined, body: body ? JSON.stringify(body) : undefined });
    const json = await res.json().catch(() => ({}));
    return { ok: res.ok, json };
  }
  function recordVisit(v: { tripId?: number; title?: string; destination: string }) {
    api('/api/visits', 'POST', v).then(() => loadRecent()).catch(() => {});
  }

  // ---- skeleton builders ----
  const skelTrip = () => `<div class="skel-card"><div class="skeleton skel-cover"></div><div class="skel-body"><div class="skeleton skel-line" style="width:70%;height:16px"></div><div class="skeleton skel-line" style="width:45%"></div><div class="skeleton skel-line" style="width:90%"></div><div class="skeleton skel-line" style="width:80%"></div></div></div>`;
  const skelRecent = () => `<div class="skel-card"><div class="skeleton" style="height:74px"></div><div class="skel-body"><div class="skeleton skel-line" style="width:65%;height:15px"></div><div class="skeleton skel-line" style="width:40%"></div></div></div>`;
  const skelQuote = () => `<div class="skel-card" style="padding:26px"><div class="skeleton skel-line" style="width:30%"></div><div class="skeleton skel-line" style="width:100%"></div><div class="skeleton skel-line" style="width:95%"></div><div class="skeleton skel-line" style="width:60%"></div><div class="skeleton skel-line" style="width:45%;margin-top:16px"></div></div>`;
  const repeat = (fn: () => string, n: number) => Array.from({ length: n }, fn).join('');

  // ---- stats ----
  async function loadStats() {
    const { json } = await api('/api/stats');
    const s = json.stats || {};
    document.querySelectorAll('[data-stat]').forEach((el) => animateCount(el as HTMLElement, Number(s[(el as HTMLElement).dataset.stat as string] || 0)));
  }
  function animateCount(el: HTMLElement, target: number) {
    const dur = 900, start = performance.now();
    const step = (t: number) => { const p = Math.min((t - start) / dur, 1); el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }

  // ---- planner ----
  const plannerForm = $('planner-form') as HTMLFormElement;
  const genBtn = $('generate-btn') as HTMLButtonElement;
  plannerForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const note = $('planner-note');
    const data = Object.fromEntries(new FormData(plannerForm).entries());
    if (!String(data.destination || '').trim()) { showNote(note, 'Please enter a destination.', 'err'); return; }
    genBtn.disabled = true; genBtn.innerHTML = '<span class="spinner"></span> Building your plan…';
    hide(note);
    showItinerarySkeleton();
    try {
      const { ok, json } = await api('/api/itinerary', 'POST', data);
      if (!ok || !json.ok) throw new Error(json.error || 'Could not build an itinerary.');
      renderItinerary(json.itinerary);
      recordVisit({ title: json.itinerary.title, destination: String(data.destination) });
    } catch (err: any) { $('itinerary-result').classList.add('hidden'); showNote(note, err.message, 'err'); }
    finally { genBtn.disabled = false; genBtn.textContent = 'Build my itinerary'; }
  });

  function showItinerarySkeleton() {
    const r = $('itinerary-result');
    r.classList.remove('hidden');
    r.innerHTML = `<hr class="divider"/>
      <div class="result__head"><div><div class="skeleton skel-line" style="width:120px"></div><div class="skeleton skel-line" style="width:260px;height:24px;margin-top:8px"></div><div class="skeleton skel-line" style="width:340px"></div></div></div>
      <div class="plan-grid">${repeat(() => `<div class="day-card"><div class="skeleton skel-line" style="width:40px"></div><div class="skeleton skel-line" style="width:70%;height:15px"></div><div class="skeleton skel-line" style="width:90%"></div><div class="skeleton skel-line" style="width:60%"></div></div>`, 4)}</div>`;
    r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function renderItinerary(it: any) {
    const src = it.source === 'saved' ? 'Saved plan' : 'Recommended for you';
    const days = (it.days || []).map((d: any) => `
      <div class="day-card">
        <div class="dnum">Day ${esc(d.day)}</div>
        <h4>${esc(d.title)}</h4>
        <ul class="plan">${(d.activities || []).map((a: string) => `<li>${esc(a)}</li>`).join('')}</ul>
      </div>`).join('');
    const bookings = (it.bookingSuggestions || []).map((x: string) => `<span class="tag">${esc(x)}</span>`).join('');
    $('itinerary-result').innerHTML = `
      <hr class="divider" />
      <div class="result__head">
        <div>
          <p class="eyebrow">${src}</p>
          <h3>${esc(it.title)}</h3>
          <p class="muted">${esc(it.summary)}</p>
        </div>
        <div class="result__price">
          <span class="muted">Estimated price</span>
          <div class="price">${fmt(it.estimatedPrice, it.currency)}</div>
          <span class="muted">per person</span>
        </div>
      </div>
      <div class="plan-grid">${days}</div>
      ${bookings ? `<div id="it-bookings"><h4>Where to book</h4><div class="chips">${bookings}</div></div>` : ''}`;
    $('itinerary-result').classList.remove('hidden');
  }

  // ---- subscribe ----
  const subForm = $('subscribe-form') as HTMLFormElement;
  subForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const note = $('subscribe-note'); const btn = $('subscribe-btn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const { ok, json } = await api('/api/subscribe', 'POST', { email: ($('sub-email') as HTMLInputElement).value.trim() });
      if (!ok || !json.ok) throw new Error(json.error || 'Could not subscribe.');
      showNote(note, json.message, 'ok'); subForm.reset(); loadStats();
    } catch (err: any) { showNote(note, err.message, 'err'); }
    finally { btn.disabled = false; }
  });

  // ---- trips ----
  async function loadTrips() {
    const note = $('trips-note'); const list = $('trips');
    list.innerHTML = repeat(skelTrip, 4);
    try {
      const { json } = await api('/api/trips?sort=popular');
      const trips = json.trips || [];
      if (json.dbConfigured === false) showNote(note, 'Trips will appear once the database is connected.', 'info');
      if (!trips.length) { list.innerHTML = '<p class="muted">No trips published yet — check back soon.</p>'; return; }
      list.innerHTML = trips.map(tripCard).join('');
      list.querySelectorAll('[data-trip]').forEach((el) => el.addEventListener('click', () => {
        const t = JSON.parse((el as HTMLElement).dataset.trip as string);
        recordVisit({ tripId: t.id, title: t.title, destination: t.destination });
        openTrip(t);
      }));
    } catch { list.innerHTML = '<p class="muted">Could not load trips.</p>'; }
  }
  function tripCard(t: any) {
    const it = Array.isArray(t.itinerary) ? t.itinerary : [];
    const dates = fmtRange(t.start_date, t.end_date);
    const preview = it.slice(0, 3).map((d: any) => `<li>${esc(d.title)}</li>`).join('');
    const glyph = esc((t.destination || '?').trim().charAt(0).toUpperCase());
    const views = Number(t.views) || 0;
    return `
      <article class="trip" data-trip='${esc(JSON.stringify(t))}'>
        <div class="trip__cover" style="${cover(t.destination)}">
          <div class="trip__cover-top">
            <span class="trip__badge">${it.length || '—'} days</span>
            ${views > 0 ? `<span class="trip__badge">★ ${views} explored</span>` : ''}
          </div>
          <span class="trip__cover-name">◍ ${esc(t.destination)}</span>
          <span class="trip__cover-glyph" aria-hidden="true">${glyph}</span>
        </div>
        <div class="trip__body">
          <h3>${esc(t.title)}</h3>
          <div class="trip__meta"><span>${esc(dates)}</span><span>${esc(t.travelers)} traveler(s)</span></div>
          <ul class="plan">${preview}</ul>
          <div class="trip__foot">
            <span class="price">${fmt(Number(t.price) || 0, t.currency || 'USD')}<small> /person</small></span>
            <span class="btn btn--ghost">View plan →</span>
          </div>
        </div>
      </article>`;
  }
  function openTrip(t: any) {
    renderItinerary({
      source: 'saved', title: t.title, summary: t.summary || `${t.destination} itinerary`,
      estimatedPrice: Number(t.price) || 0, currency: t.currency || 'USD',
      days: Array.isArray(t.itinerary) ? t.itinerary : [],
      bookingSuggestions: Array.isArray(t.booking_suggestions) ? t.booking_suggestions : [],
    });
    ($('destination') as HTMLInputElement).value = t.destination;
    document.getElementById('plan')?.scrollIntoView({ behavior: 'smooth' });
  }

  // ---- recently explored ----
  async function loadRecent() {
    const list = $('recent-list');
    if (!list.dataset.loaded) list.innerHTML = repeat(skelRecent, 4);
    const { json } = await api('/api/visits?limit=8');
    const views = json.views || [];
    list.dataset.loaded = '1';
    if (!views.length) { list.innerHTML = '<p class="muted">No recent activity yet — build an itinerary to get started.</p>'; return; }
    list.innerHTML = views.map((v: any) => {
      const glyph = esc((v.destination || '?').trim().charAt(0).toUpperCase());
      const hasTrip = v.trip_id && v.price != null;
      return `
        <button class="recent" data-dest="${esc(v.destination)}">
          <div class="recent__cover" style="${cover(v.destination)}">
            <span class="recent__glyph">${glyph}</span>
            <span class="recent__when">${esc(timeAgo(v.viewed_at))}</span>
          </div>
          <div class="recent__body">
            <b>${esc(v.title || v.destination)}</b>
            <span class="recent__dest">◍ ${esc(v.destination)}</span>
            <div class="recent__foot">
              ${hasTrip ? `<span class="price">${fmt(Number(v.price), v.currency || 'USD')}<small> /person</small></span>` : `<span class="muted" style="font-size:13px;">Custom plan</span>`}
              ${hasTrip && v.days ? `<span class="tag">${esc(v.days)} days</span>` : `<span class="recent__cta">Plan this →</span>`}
            </div>
          </div>
        </button>`;
    }).join('');
    list.querySelectorAll('.recent').forEach((el) => el.addEventListener('click', () => {
      ($('destination') as HTMLInputElement).value = (el as HTMLElement).dataset.dest || '';
      document.getElementById('plan')?.scrollIntoView({ behavior: 'smooth' });
      ($('destination') as HTMLInputElement).focus();
    }));
  }

  // ---- testimonials ----
  async function loadTestimonials() {
    const list = $('testimonials');
    list.innerHTML = repeat(skelQuote, 3);
    const { json } = await api('/api/testimonials');
    const items = json.testimonials || [];
    if (!items.length) { list.innerHTML = '<p class="muted">No reviews yet.</p>'; return; }
    list.innerHTML = items.map((t: any) => {
      const initial = esc((t.name || '?').trim().charAt(0).toUpperCase());
      return `
        <figure class="quote">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <p>“${esc(t.quote)}”</p>
          <figcaption class="who">
            <span class="av" style="background:${solid(t.name)}">${initial}</span>
            <span><b>${esc(t.name)}</b><span>${esc(t.detail)}</span></span>
          </figcaption>
        </figure>`;
    }).join('');
  }

  loadStats(); loadTrips(); loadRecent(); loadTestimonials();
</script>
