---
interface Props {
  title?: string;
  active?: 'home' | 'admin';
}
const { title, active = 'home' } = Astro.props;
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'AI Trip Planner';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Plan personalized trips with AI itineraries, pricing, booking suggestions and email reminders." />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">✈️ {siteName}</a>
      <nav>
        <a href="/" class={active === 'home' ? 'active' : ''}>Planner</a>
        <a href="/admin" class={active === 'admin' ? 'active' : ''}>Admin</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <span>{siteName} — built with Astro, Neon &amp; Gemini.</span>
    </footer>

    <style is:global>
      :root {
        --bg: #0f1226;
        --panel: #ffffff;
        --ink: #111827;
        --muted: #6b7280;
        --brand: #3245ff;
        --brand2: #bc52ee;
        --line: #e5e7eb;
        --ok: #16a34a;
        --err: #dc2626;
        --radius: 14px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(1200px 600px at 10% -10%, rgba(50,69,255,.18), transparent 60%),
          radial-gradient(1000px 500px at 100% 0%, rgba(188,82,238,.18), transparent 55%),
          #f6f7fb;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .container { width: 100%; max-width: 1040px; margin: 0 auto; padding: 24px 20px 56px; flex: 1; }
      .site-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 24px; background: rgba(255,255,255,.7); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10;
      }
      .brand { font-weight: 800; font-size: 18px; text-decoration: none; color: var(--ink); }
      .site-header nav { display: flex; gap: 8px; }
      .site-header nav a {
        text-decoration: none; color: var(--muted); padding: 8px 14px; border-radius: 10px; font-weight: 600;
      }
      .site-header nav a.active, .site-header nav a:hover { color: var(--ink); background: rgba(50,69,255,.10); }
      .site-footer { text-align: center; color: var(--muted); font-size: 13px; padding: 20px; }

      .card {
        background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
        padding: 22px; box-shadow: 0 10px 30px rgba(17,24,39,.06); margin-bottom: 22px;
      }
      h1 { font-size: 30px; margin: 0 0 6px; letter-spacing: -0.02em; }
      h2 { font-size: 20px; margin: 0 0 14px; }
      h3 { font-size: 16px; margin: 16px 0 8px; }
      .lead { color: var(--muted); margin: 0 0 20px; font-size: 16px; }

      label { display: block; font-weight: 600; font-size: 13px; margin: 0 0 6px; color: #374151; }
      input, select, textarea {
        width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 10px;
        font: inherit; color: var(--ink); background: #fff; transition: border-color .15s, box-shadow .15s;
      }
      input:focus, select:focus, textarea:focus {
        outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(50,69,255,.15);
      }
      textarea { resize: vertical; min-height: 72px; }
      .grid { display: grid; gap: 14px; }
      .grid-2 { grid-template-columns: 1fr 1fr; }
      .grid-3 { grid-template-columns: 1fr 1fr 1fr; }
      .field { margin-bottom: 14px; }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        border: none; cursor: pointer; font: inherit; font-weight: 700; padding: 12px 18px;
        border-radius: 11px; color: #fff;
        background: linear-gradient(83deg, var(--brand) 0%, var(--brand2) 100%);
        transition: transform .05s ease, opacity .15s; text-decoration: none;
      }
      .btn:hover { opacity: .94; }
      .btn:active { transform: translateY(1px); }
      .btn[disabled] { opacity: .55; cursor: not-allowed; }
      .btn-secondary { background: #111827; }
      .btn-ghost { background: transparent; color: var(--brand); border: 1px solid var(--line); }

      .note { font-size: 13px; padding: 10px 12px; border-radius: 10px; margin-top: 12px; }
      .note.ok { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
      .note.err { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
      .note.info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
      .hidden { display: none !important; }

      .price { font-size: 22px; font-weight: 800; color: var(--brand); }
      .pill { display: inline-block; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: rgba(50,69,255,.1); color: var(--brand); }
      .muted { color: var(--muted); }

      .trip-list { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
      .trip { border: 1px solid var(--line); border-radius: 12px; padding: 16px; background: #fff; }
      .trip h3 { margin: 0 0 4px; }
      .trip .dest { color: var(--muted); font-size: 14px; margin: 0 0 10px; }
      ul.tight { margin: 6px 0 0; padding-left: 18px; }
      ul.tight li { margin-bottom: 4px; }

      .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.5); border-top-color:#fff; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
      @keyframes spin { to { transform: rotate(360deg); } }

      @media (max-width: 640px) {
        .grid-2, .grid-3 { grid-template-columns: 1fr; }
        h1 { font-size: 24px; }
      }
    </style>
  </body>
</html>
