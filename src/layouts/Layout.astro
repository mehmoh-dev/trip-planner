---
interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'trips' | 'about' | 'admin';
}
const { title, description, active = 'home' } = Astro.props;
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'Wander';
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · Thoughtful trips, planned in minutes`;
const desc =
  description ||
  'Plan personalized trips with day-by-day itineraries, honest pricing, booking tips and email reminders.';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="nav">
      <div class="nav__inner wrap">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
              <path d="M3 12h13l3.5-4M3 12l3.5 4H16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="19" cy="6" r="2" fill="currentColor"/>
            </svg>
          </span>
          <span>{siteName}</span>
        </a>
        <nav class="nav__links">
          <a href="/#plan" class={active === 'home' ? 'is-active' : ''}>Plan</a>
          <a href="/#trips" class={active === 'trips' ? 'is-active' : ''}>Trips</a>
          <a href="/about" class={active === 'about' ? 'is-active' : ''}>About</a>
          <a href="/admin" class={`nav__admin ${active === 'admin' ? 'is-active' : ''}`}>Admin</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <div class="footer__brand">
          <div class="brand brand--footer">
            <span class="brand__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <path d="M3 12h13l3.5-4M3 12l3.5 4H16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="19" cy="6" r="2" fill="currentColor"/>
              </svg>
            </span>
            <span>{siteName}</span>
          </div>
          <p>Personalized itineraries, honest pricing, and a nudge by email when a new trip drops.</p>
        </div>
        <div class="footer__cols">
          <div>
            <h4>Explore</h4>
            <a href="/#plan">Plan a trip</a>
            <a href="/#trips">Featured trips</a>
            <a href="/#recent">Recently explored</a>
          </div>
          <div>
            <h4>Company</h4>
            <a href="/about">About</a>
            <a href="/#faq">FAQ</a>
            <a href="/admin">Admin</a>
          </div>
          <div>
            <h4>Stay in touch</h4>
            <a href="/#subscribe">Get trip updates</a>
          </div>
        </div>
      </div>
      <div class="wrap footer__base">
        <span>© {year} {siteName}. Made for people who love the planning almost as much as the trip.</span>
      </div>
    </footer>

    <style is:global>
      :root {
        --ink: #14282f;
        --ink-soft: #33525d;
        --muted: #6d8189;
        --primary: #0f766e;
        --primary-600: #0c645d;
        --primary-050: #e7f6f2;
        --accent: #d8623b;
        --accent-600: #c1502c;
        --accent-050: #fbeee7;
        --sand: #faf7f1;
        --sand-2: #f2ede3;
        --surface: #ffffff;
        --line: #e7e0d4;
        --line-2: #efe9dd;
        --ok: #16794f;
        --ok-bg: #e9f7ef;
        --err: #b4342a;
        --err-bg: #fbeceb;
        --info: #1f5f8b;
        --info-bg: #eaf3fa;
        --radius: 16px;
        --radius-sm: 11px;
        --shadow: 0 18px 40px -24px rgba(20, 40, 47, 0.35);
        --shadow-sm: 0 8px 20px -14px rgba(20, 40, 47, 0.4);
        --serif: 'Fraunces', Georgia, 'Times New Roman', serif;
        --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 84px; }
      body {
        margin: 0;
        font-family: var(--sans);
        color: var(--ink);
        background: var(--sand);
        -webkit-font-smoothing: antialiased;
        line-height: 1.55;
      }
      h1, h2, h3, h4 { font-family: var(--serif); font-weight: 500; color: var(--ink); letter-spacing: -0.01em; line-height: 1.12; margin: 0; }
      p { margin: 0; }
      a { color: inherit; }
      img { max-width: 100%; display: block; }

      .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 22px; }
      .wrap--narrow { max-width: 760px; }
      .section { padding: 68px 0; }
      .section--tight { padding: 44px 0; }
      .eyebrow {
        font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--primary); margin: 0 0 12px;
      }
      .section-head { max-width: 640px; margin-bottom: 34px; }
      .section-head h2 { font-size: clamp(26px, 3.4vw, 36px); }
      .section-head p { color: var(--muted); margin-top: 12px; font-size: 17px; }
      .center { text-align: center; margin-left: auto; margin-right: auto; }

      /* ---- Header ---- */
      .nav {
        position: sticky; top: 0; z-index: 50;
        background: rgba(250, 247, 241, 0.86); backdrop-filter: saturate(140%) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .nav__inner { display: flex; align-items: center; justify-content: space-between; height: 66px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--serif); font-size: 21px; font-weight: 600; text-decoration: none; color: var(--ink); }
      .brand__mark {
        display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px;
        background: var(--primary); color: #fff;
      }
      .nav__links { display: flex; align-items: center; gap: 6px; font-family: var(--sans); }
      .nav__links a { text-decoration: none; color: var(--ink-soft); font-weight: 600; font-size: 15px; padding: 9px 14px; border-radius: 9px; transition: background .15s, color .15s; }
      .nav__links a:hover { background: var(--sand-2); color: var(--ink); }
      .nav__links a.is-active { color: var(--primary); }
      .nav__admin { border: 1px solid var(--line); }

      /* ---- Buttons ---- */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 9px;
        font-family: var(--sans); font-weight: 600; font-size: 15px; cursor: pointer;
        border: 1px solid transparent; border-radius: 11px; padding: 12px 20px; text-decoration: none;
        transition: transform .06s ease, background .15s, box-shadow .15s, border-color .15s; white-space: nowrap;
      }
      .btn:active { transform: translateY(1px); }
      .btn[disabled] { opacity: .55; cursor: not-allowed; }
      .btn--primary { background: var(--accent); color: #fff; box-shadow: var(--shadow-sm); }
      .btn--primary:hover { background: var(--accent-600); }
      .btn--dark { background: var(--ink); color: #fff; }
      .btn--dark:hover { background: #0c1c22; }
      .btn--teal { background: var(--primary); color: #fff; }
      .btn--teal:hover { background: var(--primary-600); }
      .btn--outline { background: var(--surface); color: var(--ink); border-color: var(--line); }
      .btn--outline:hover { border-color: var(--primary); color: var(--primary); }
      .btn--ghost { background: transparent; color: var(--primary); padding-left: 8px; padding-right: 8px; }
      .btn--lg { padding: 15px 26px; font-size: 16px; }
      .btn--block { width: 100%; }

      /* ---- Cards & surfaces ---- */
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow); }
      .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }

      /* ---- Forms ---- */
      label, .label { display: block; font-family: var(--sans); font-weight: 600; font-size: 13px; margin-bottom: 7px; color: var(--ink-soft); }
      input, select, textarea {
        width: 100%; font: inherit; color: var(--ink); background: #fff;
        border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px 13px;
        transition: border-color .15s, box-shadow .15s;
      }
      input::placeholder, textarea::placeholder { color: #a7b3b8; }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-050); }
      textarea { resize: vertical; min-height: 78px; }
      .field { margin-bottom: 15px; }
      .grid { display: grid; gap: 15px; }
      .grid-2 { grid-template-columns: 1fr 1fr; }
      .grid-3 { grid-template-columns: repeat(3, 1fr); }
      .grid-4 { grid-template-columns: repeat(4, 1fr); }

      /* ---- Bits ---- */
      .pill { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 12.5px; font-weight: 700; letter-spacing: .02em; padding: 5px 12px; border-radius: 999px; background: var(--primary-050); color: var(--primary); }
      .tag { display: inline-block; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--sand-2); color: var(--ink-soft); border: 1px solid var(--line-2); }
      .muted { color: var(--muted); }
      .price { font-family: var(--serif); font-size: 26px; color: var(--accent-600); font-weight: 600; }
      .price small { font-family: var(--sans); font-size: 12px; font-weight: 600; color: var(--muted); }
      .hidden { display: none !important; }
      .divider { height: 1px; background: var(--line); border: 0; margin: 0; }

      .note { font-family: var(--sans); font-size: 14px; padding: 11px 14px; border-radius: var(--radius-sm); margin-top: 14px; border: 1px solid transparent; }
      .note.ok { background: var(--ok-bg); color: var(--ok); border-color: #bfe6cf; }
      .note.err { background: var(--err-bg); color: var(--err); border-color: #f2c9c5; }
      .note.info { background: var(--info-bg); color: var(--info); border-color: #cfe3f1; }

      .spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.45); border-top-color:#fff; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* ---- Trip cards ---- */
      .trip-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(285px, 1fr)); }
      .trip {
        display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line);
        border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm);
        transition: transform .16s ease, box-shadow .16s ease; cursor: pointer;
      }
      .trip:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
      .trip__cover { height: 116px; position: relative; display: flex; align-items: flex-end; padding: 14px; color: #fff; }
      .trip__cover .tag { background: rgba(255,255,255,.9); color: var(--ink); border: 0; }
      .trip__body { padding: 18px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
      .trip__body h3 { font-size: 20px; }
      .trip__dest { font-family: var(--sans); font-size: 13.5px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
      .trip__foot { margin-top: auto; padding-top: 12px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line-2); }
      ul.plan { list-style: none; margin: 4px 0 0; padding: 0; font-family: var(--sans); font-size: 13.5px; color: var(--ink-soft); }
      ul.plan li { display: flex; gap: 8px; padding: 2px 0; }
      ul.plan li::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: 8px; border-radius: 50%; background: var(--primary); }

      /* ---- Steps / features / testimonials / faq ---- */
      .steps, .features { display: grid; gap: 20px; grid-template-columns: repeat(3, 1fr); }
      .step__num { font-family: var(--serif); font-size: 30px; color: var(--accent); }
      .step h3, .feature h3 { font-size: 19px; margin: 12px 0 6px; }
      .step p, .feature p { color: var(--muted); font-size: 15px; }
      .feature__icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--primary-050); color: var(--primary); }
      .testimonials { display: grid; gap: 20px; grid-template-columns: repeat(3, 1fr); }
      .quote { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow-sm); }
      .quote p { font-family: var(--serif); font-size: 17px; line-height: 1.5; color: var(--ink); }
      .quote .who { margin-top: 16px; font-family: var(--sans); font-size: 14px; }
      .quote .who b { display: block; }
      .quote .who span { color: var(--muted); }
      .faq details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 4px 18px; margin-bottom: 12px; }
      .faq summary { font-family: var(--serif); font-size: 18px; padding: 15px 0; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: "+"; font-family: var(--sans); color: var(--primary); font-size: 22px; }
      .faq details[open] summary::after { content: "\2013"; }
      .faq p { color: var(--muted); padding: 0 0 16px; font-size: 15px; }

      /* ---- Footer ---- */
      .footer { margin-top: 40px; background: var(--ink); color: #cdd9dc; font-family: var(--sans); }
      .footer__inner { display: grid; grid-template-columns: 1.3fr 2fr; gap: 40px; padding: 54px 22px 34px; }
      .footer__brand p { margin-top: 14px; max-width: 300px; color: #9db0b5; font-size: 14.5px; }
      .brand--footer { color: #fff; font-size: 19px; }
      .brand--footer .brand__mark { background: rgba(255,255,255,.14); }
      .footer__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
      .footer__cols h4 { font-family: var(--sans); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: #7f959b; margin-bottom: 12px; }
      .footer__cols a { display: block; text-decoration: none; color: #cdd9dc; font-size: 14.5px; padding: 5px 0; transition: color .15s; }
      .footer__cols a:hover { color: #fff; }
      .footer__base { border-top: 1px solid rgba(255,255,255,.1); padding: 20px 22px; font-size: 13px; color: #8ba0a5; }

      @media (max-width: 860px) {
        .steps, .features, .testimonials, .grid-3, .grid-4 { grid-template-columns: 1fr 1fr; }
        .footer__inner { grid-template-columns: 1fr; gap: 28px; }
      }
      @media (max-width: 620px) {
        .section { padding: 48px 0; }
        .grid-2, .grid-3, .grid-4, .steps, .features, .testimonials { grid-template-columns: 1fr; }
        .nav__links a { padding: 8px 10px; font-size: 14px; }
        .brand span:last-child { display: none; }
      }
    </style>
  </body>
</html>
