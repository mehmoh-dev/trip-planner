# Copy this file to .env.local and fill in the values.
# On Vercel, add these under Project Settings > Environment Variables.

# --- Neon Postgres ---
# Add via Vercel > Storage > Neon. Use the POOLED connection string.
# The app checks DATABASE_URL, then POSTGRES_URL, then NEON_DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Gmail notifications (App Password, not your login password) ---
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# --- Admin panel login ---
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=choose-a-strong-password
# Long random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Gemini AI (itinerary generation) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- UI ---
PUBLIC_SITE_NAME=AI Trip Planner
